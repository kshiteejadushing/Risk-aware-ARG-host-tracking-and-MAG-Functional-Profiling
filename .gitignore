# =========================================================
# Shotgun Metagenomics Project .gitignore
# Keep GitHub repo limited to scripts, README, LICENSE, docs
# Do not upload raw data, databases, results, or manuscript files
# =========================================================


# -------------------------
# Raw and processed data
# -------------------------
data/raw/
data/clean/
data/metawrap_reads/
data/databases/
Databases/
databases/


# -------------------------
# Analysis outputs
# -------------------------
results/
logs/
final_tables/
output/
outputs/


# -------------------------
# Unpublished notes, manuscript, figures, tables
# -------------------------
Notes/
notes/
manuscript/
Manuscript/
figures/
Figures/
tables/
Tables/
*.docx
*.doc
*.pdf
*.pptx
*.xlsx


# -------------------------
# Large sequencing and bioinformatics files
# -------------------------
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fasta
*.fa
*.fna
*.faa
*.ffn
*.gff
*.gff3
*.gbk
*.sam
*.bam
*.bai
*.cram
*.vcf
*.vcf.gz


# -------------------------
# Database/index/model files
# -------------------------
*.bt2
*.bt2l
*.mmi
*.dmnd
*.hmm
*.h3f
*.h3i
*.h3m
*.h3p
*.idx
*.k2d
*.sqlite
*.sqlite3
*.db


