# Compressed archives
# -------------------------
*.tar
*.tar.gz
*.tgz
*.zip
*.gz
*.bz2
*.xz
*.7z
*.rar


# -------------------------
# Temporary/intermediate files
# -------------------------
tmp/
temp/
work/
work_files/
*.tmp
*.temp
*.bak
*.swp
*.swo


# -------------------------
# Python files
# -------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/


# -------------------------
# R files
# -------------------------
.Rhistory
.RData
.Rproj.user/


# -------------------------
# Conda/environment files
# Keep example environment files if needed
# -------------------------
.conda/
env/
envs/
venv/
.venv/


# -------------------------
# Editor/system files
